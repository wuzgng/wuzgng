---
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL;

const navItems = [
  { label: "Home", href: "#home" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Award", href: "#award" },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-background/70 backdrop-blur-md dark:border-border-dark dark:bg-background-dark/70">
  <div class="flex items-center justify-between gap-4 px-5 py-5 sm:px-8">
    <div class="flex items-baseline gap-6 sm:gap-9">
      <a
        class="text-2xl font-bold tracking-[-0.02em] text-text-primary no-underline transition-colors duration-200 hover:text-accent sm:text-3xl dark:text-text-primary-dark dark:hover:text-accent"
        href={base}
      >
        ZG's Homepage
      </a>
      <nav class="relative hidden items-center gap-5 sm:flex sm:gap-7" aria-label="主导航">
        {navItems.map((item) => (
          <a class="nav-link text-base no-underline" href={item.href}>{item.label}</a>
        ))}
        <span class="nav-indicator" aria-hidden="true"></span>
      </nav>
    </div>

    <ThemeToggle />
  </div>
</header>

<style>
  .nav-link {
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color 0.25s ease;
  }

  :global(.dark) .nav-link {
    color: var(--color-text-secondary-dark);
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    border-radius: 999px;
    background: var(--color-accent);
    transition:
      left 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

</style>

<script>
  // ClientRouter-safe scroll-spy: query the DOM fresh on every run so it keeps
  // working after navigating away from and back to the homepage. The guard
  // ensures listeners are only bound once even if this script re-runs.
  (() => {
    if (window.__navScrollSpy) {
      return;
    }
    window.__navScrollSpy = true;

    const offset = 120;

    const read = () => {
      const links = Array.from(document.querySelectorAll(".nav-link"));
      const indicator = document.querySelector(".nav-indicator");
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href") || ""))
        .filter(Boolean);
      return { links, indicator, sections };
    };

    const update = () => {
      const { links, indicator, sections } = read();
      if (!links.length || !indicator) {
        return;
      }

      let currentId = sections.length ? sections[0].id : "";
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= offset) {
          currentId = section.id;
        }
      }

      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        currentId = sections[sections.length - 1].id;
      }

      let activeLink = null;
      for (const link of links) {
        const isActive = link.getAttribute("href") === `#${currentId}`;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          activeLink = link;
        }
      }

      if (activeLink) {
        indicator.style.left = `${activeLink.offsetLeft}px`;
        indicator.style.width = `${activeLink.offsetWidth}px`;
      }
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }
      const link = event.target.closest(".nav-link");
      if (!link) {
        return;
      }
      const { links, indicator } = read();
      if (!indicator) {
        return;
      }
      for (const item of links) {
        item.classList.toggle("is-active", item === link);
      }
      indicator.style.left = `${link.offsetLeft}px`;
      indicator.style.width = `${link.offsetWidth}px`;
    });

    document.addEventListener("astro:page-load", update);
    update();
  })();
</script>
