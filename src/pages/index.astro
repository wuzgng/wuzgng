---
import { getCollection } from "astro:content";

import BlogListLayout from "../components/blog/BlogListLayout.astro";
import { sortPostsByDateDesc } from "../lib/blog";

const posts = sortPostsByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
);
---

<BlogListLayout
  posts={posts}
  title="Homepage"
  description="吴正光的个人主页"
/>
