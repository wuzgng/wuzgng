---
import { getCollection, render } from "astro:content";

import "../../styles/global.css";
import "katex/dist/katex.min.css";

import BackHome from "../../components/layout/BackHome.astro";
import TableOfContents from "../../components/layout/TableOfContents.astro";
import SiteHead from "../../components/layout/SiteHead.astro";
import ThemeToggle from "../../components/layout/ThemeToggle.astro";
import { site } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocItems.length > 0;

---

<html lang="zh-CN">
  <head>
    <SiteHead
      title={post.data.title}
      description={post.data.description ?? site.defaultDescription}
      type="article"
      publishedTime={post.data.date.toISOString()}
    />
  </head>
  <body class="min-h-screen">
    <main class="relative z-10 text-text-primary dark:text-text-primary-dark">
      {hasToc && (
        <aside class="toc-fixed fixed left-0 top-0 z-30 hidden h-screen xl:block" aria-label="文章目录">
          <div class="flex h-full items-center">
            <div class="flex items-start gap-2">
              <button
                type="button"
                class="toc-toggle"
                aria-expanded="true"
                aria-controls="toc-body"
                aria-label="展开或收起目录"
              >
                <svg class="toc-toggle__icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </button>
              <div id="toc-body" class="toc-body scrollbar-thin">
                <div class="toc-body__inner">
                  <TableOfContents headings={tocItems} />
                </div>
              </div>
            </div>
          </div>
        </aside>
      )}

      <div class="mx-auto w-full max-w-[64rem] px-4 py-10 sm:px-6 sm:py-16">
        <div class="fixed right-4 top-4 z-40 sm:right-6 sm:top-6">
          <ThemeToggle />
        </div>

        <div class="min-w-0 w-full">
          <div class="mb-8">
            <BackHome />
          </div>

          <header class="border-b border-border pb-10 dark:border-border-dark">
            <h1 class="m-0 text-3xl font-bold leading-10 tracking-[-0.03em] sm:text-4xl">{post.data.title}</h1>
            {
              post.data.description && (
                <p class="mt-6 text-base leading-8 text-text-secondary dark:text-text-secondary-dark">
                  {post.data.description}
                </p>
              )
            }
          </header>

          <div class="article-content mt-10">
            <Content />
          </div>
        </div>
      </div>
    </main>

    <script>
      // ClientRouter-safe TOC toggle: delegate the click and resolve the toggle
      // from the live DOM at click time, so it keeps working after client-side
      // navigation swaps in a fresh `.toc-fixed`. The guard binds the listener once.
      (() => {
        if (window.__tocToggle) return;
        window.__tocToggle = true;

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;
          const toggle = event.target.closest(".toc-toggle");
          if (!toggle) return;
          const toc = toggle.closest(".toc-fixed");
          if (!toc) return;

          const collapsed = toc.classList.toggle("is-collapsed");
          toggle.setAttribute("aria-expanded", String(!collapsed));
        });
      })();
    </script>
  </body>
</html>

<style>
  .article-content {
    color: var(--color-text-primary);
    font-size: 1.0625rem;
    line-height: 2.0;
  }

  :global(.dark) .article-content {
    color: var(--color-text-primary-dark);
  }

  .article-content :global(:where(h2, h3, h4)) {
    margin: 2rem 0 0.75rem;
    line-height: 1.35;
    letter-spacing: -0.04em;
    scroll-margin-top: 2rem;
  }

  .article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .article-content :global(:where(p, ul, ol, blockquote)) {
    margin: 1rem 0;
  }

  .article-content :global(:where(ul, ol)) {
    padding-left: 1.25rem;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-secondary);
  }

  :global(.dark) .article-content :global(blockquote) {
    color: var(--color-text-secondary-dark);
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    text-decoration: underline;
  }

  .article-content :global(code) {
    border-radius: 0.35rem;
    background: rgb(142 164 200 / 0.12);
    padding: 0.12rem 0.28rem;
    font-size: 0.92em;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    border-radius: var(--radius-card);
    background: rgb(15 23 42 / 0.92);
    padding: 1rem;
    color: rgb(248 250 252);
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .toc-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-left: 0;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--color-background);
    color: var(--color-text-secondary);
    cursor: pointer;
    box-shadow: 0 0.25rem 1rem rgb(15 23 42 / 0.08);
    transition: color 0.2s ease;
  }

  :global(.dark) .toc-toggle {
    border-color: var(--color-border-dark);
    background: var(--color-background-dark);
    color: var(--color-text-secondary-dark);
  }

  .toc-toggle:hover {
    color: var(--color-accent);
  }

  .toc-toggle__icon {
    transition: transform 0.25s ease;
  }

  .toc-fixed.is-collapsed .toc-toggle__icon {
    transform: rotate(180deg);
  }

  .toc-body {
    width: 13rem;
    max-height: calc(100vh - 4rem);
    overflow-x: hidden;
    overflow-y: auto;
    transition:
      width 0.25s ease,
      opacity 0.2s ease;
  }

  .toc-fixed.is-collapsed .toc-body {
    width: 0;
    opacity: 0;
    pointer-events: none;
  }

  .toc-body__inner {
    width: 13rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
    box-shadow: 0 1rem 2.5rem rgb(15 23 42 / 0.12);
  }

  :global(.dark) .toc-body__inner {
    border-color: var(--color-border-dark);
    background: var(--color-card-dark);
  }
</style>
