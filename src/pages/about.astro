---
import "../styles/global.css";

import Resume from "../components/about/Resume.astro";
import BackHome from "../components/layout/BackHome.astro";
import SiteHead from "../components/layout/SiteHead.astro";
import ThemeToggle from "../components/layout/ThemeToggle.astro";

const pageTitle = "About me";
---

<html lang="zh-CN">
  <head>
    <SiteHead title="About" description="吴正光的个人简历" />
  </head>
  <body class="min-h-screen">
    <main class="relative z-10 text-text-primary dark:text-text-primary-dark">
      <div class="mx-auto w-full max-w-[64rem] px-4 py-10 sm:px-6 sm:py-16">
        <div class="fixed right-4 top-4 z-40 sm:right-6 sm:top-6">
          <ThemeToggle />
        </div>
        <div class="mb-8">
          <BackHome />
        </div>

        <header class="border-b border-border pb-10 dark:border-border-dark">
          <h1 class="text-3xl font-bold leading-10 tracking-[-0.03em] sm:text-4xl">{pageTitle}</h1>
          <p class="mt-4 text-sm text-text-muted dark:text-text-muted-dark">更新时间：2026/06</p>
        </header>

        <div class="article-content mt-10">
          <Resume />
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .article-content {
    color: var(--color-text-primary);
    font-size: 1.125rem;
    line-height: 1.9;
  }

  :global(.dark) .article-content {
    color: var(--color-text-primary-dark);
  }

  .article-content :global(p) {
    margin: 1rem 0;
  }
</style>
